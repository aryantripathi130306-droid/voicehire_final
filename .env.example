# VoiceHire Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# =============================================
# SUPABASE CONFIGURATION (required)
# =============================================
# Your Supabase project URL — found in Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — found in Settings > API
# WARNING: Keep this secret. It bypasses Row Level Security.
# For production, consider using the anon key with RLS policies instead.
SUPABASE_KEY=your-supabase-service-role-key-here

# =============================================
# FLASK CONFIGURATION (required)
# =============================================
# Secret key for signing session cookies
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-strong-random-secret-key

# =============================================
# OPTIONAL CONFIGURATION
# =============================================
# Enable Flask debug mode (True in development, NEVER True in production)
FLASK_DEBUG=False

# Port to run the application on (default: 5000)
PORT=5000

# =============================================
# RAZORPAY PAYMENT GATEWAY (required for online payments)
# =============================================
# Razorpay Key ID and Secret Key from Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret configured in Razorpay Webhooks dashboard for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=
